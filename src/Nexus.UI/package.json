{
  "name": "nexus-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.cjs",
    "build": "ng build",
    "lint": "ng build --configuration development && npm run eslint && prettier --check . \"../../tests/Nexus.UI.Tests/**/*.ts\" \"../../tests/js/**/*.{js,json}\" \"../../tests/integration/**/*.{ts,md}\"",
    "eslint": "cd ../.. && node src/Nexus.UI/node_modules/eslint/bin/eslint.js src/Nexus.UI/src tests/Nexus.UI.Tests tests/js tests/integration",
    "eslint:fix": "cd ../.. && node src/Nexus.UI/node_modules/eslint/bin/eslint.js src/Nexus.UI/src tests/Nexus.UI.Tests tests/js tests/integration --fix",
    "format": "prettier --check . \"../../tests/Nexus.UI.Tests/**/*.ts\" \"../../tests/js/**/*.{js,json}\" \"../../tests/integration/**/*.{ts,md}\"",
    "format:fix": "prettier --write . \"../../tests/Nexus.UI.Tests/**/*.ts\" \"../../tests/js/**/*.{js,json}\" \"../../tests/integration/**/*.{ts,md}\"",
    "test": "tsc -p tsconfig.selection-tests.json && node --test ../../tests/Nexus.UI.Tests/resource-selection.test.ts ../../tests/Nexus.UI.Tests/resource-matrix.test.ts ../../tests/Nexus.UI.Tests/charts/*.test.ts ../../tests/Nexus.UI.Tests/json-schema.test.ts ../../tests/Nexus.UI.Tests/data-source-pipelines.test.ts ../../tests/Nexus.UI.Tests/yaml-monaco.test.ts ../../tests/Nexus.UI.Tests/nexus-ui-setup.test.ts",
    "test:integration-types": "tsc -p ../../tests/integration/tsconfig.json",
    "test:integration-smoke": "cd ../.. && node tests/integration/visualization-smoke.ts"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lucide/angular": "^1.45.0",
    "@primeuix/themes": "^2.0.3",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "apache-arrow": "^21.2.0",
    "marked": "^17.0.1",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "^5.5.1",
    "ngx-monaco-editor-v2": "^21.1.4",
    "primeng": "^21.1.10",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
