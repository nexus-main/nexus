@page "/chart-test"

<PageTitle>Chart Test Page</PageTitle>

<div class="h-full min-h-0 p-5 flex flex-col">
    <MudSelect T="int"
               @bind-Value="SelectedCount"
               Label="Samples per series"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Style="max-width: 220px; margin-bottom: 1rem;">
        <MudSelectItem Value="120">Default (120)</MudSelectItem>
        <MudSelectItem Value="100_000">100 k</MudSelectItem>
        <MudSelectItem Value="1_000_000">1 M</MudSelectItem>
        <MudSelectItem Value="10_000_000">10 M</MudSelectItem>
    </MudSelect>

    <div class="flex-1 min-h-0">
        <Chart @key="SelectedCount" LineSeriesData="_lineSeriesData" BeginAtZero="true" />
    </div>
</div>
