@implements IDisposable

@inject ISnackbar Snackbar
@inject AppState AppState
@inject INexusClient Client

@if (_sizeLimitExceeded)
{
    <div class="h-2/3 flex flex-col justify-center items-center mx-auto text-gray-300">
        <span class="font-bold text-2xl">¯\_(ツ)_/¯</span>
        <span class="mt-5 text-3xl ">Size limit (@(AppState.UISettings.EffectiveDataViewMemoryLimitMiB) MiB) exceeded</span>
        <span class="mt-3 text-lg text-gray-400">Increase the data view memory limit in the settings.</span>
    </div>
}
else
{
    if (_lineSeriesData is null)
    {
        <div class="h-full flex justify-center items-center mx-auto">
            <MudProgressCircular 
            Color="Color.Primary"
            Value="_progress"
            Max="1" />
            <span class="ml-3 text-gray-400">Loading data ...</span>
        </div>
    }

    else
    {
        <div class="h-full p-5 relative">
            <Chart LineSeriesData="_lineSeriesData" BeginAtZero="AppState.BeginAtZero" />

            <MudOverlay Visible="_showReloadButton" DarkBackground AutoClose Absolute>
                <MudButton
                StartIcon="@Icons.Material.Filled.Refresh"
                Variant="Variant.Filled"
                Color="Color.Secondary"
                OnClick="LoadDataAsync">
                    Reload
                </MudButton>
            </MudOverlay>
        </div>
    }
}

@code {

    private PropertyChangedEventHandler _handler;

    private bool _sizeLimitExceeded;

    private bool _isLoading;

    private double _progress;

    private bool _showReloadButton;

    private LineSeriesData? _lineSeriesData;

    private CancellationTokenSource? _cts;

    public DataView()
    {
        _handler = (sender, e) =>
        {
            if (e.PropertyName == nameof(AppState.BeginAtZero))
            {
                StateHasChanged();
            }

            else if (e.PropertyName == nameof(AppState.Settings.CanVisualize) ||
                     e.PropertyName == nameof(AppState.Settings.IsSizeLimitExceeded) ||
                     e.PropertyName == nameof(AppState.UISettings))
            {
                var wasExceeded = _sizeLimitExceeded;
                _sizeLimitExceeded = AppState.Settings.IsSizeLimitExceeded;
                _showReloadButton = !_sizeLimitExceeded && AppState.Settings.CanVisualize;

                if (wasExceeded && !_sizeLimitExceeded && _lineSeriesData is null)
                    _ = LoadDataAsync();

                StateHasChanged();
            }
        };
    }

    protected override Task OnInitializedAsync()
    {
        AppState.PropertyChanged += _handler;
        AppState.Settings.PropertyChanged += _handler;

        return LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _showReloadButton = false;

        if (AppState.Settings.IsSizeLimitExceeded)
        {
            _sizeLimitExceeded = true;
            _isLoading = false;
            StateHasChanged();
            return;
        }

        _sizeLimitExceeded = false;

        _progress = 0;
        _lineSeriesData = null;
        _isLoading = true;

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        StateHasChanged();

        _ = Task.Run(async () =>
        {
            while (_isLoading)
            {
                await Task.Delay(TimeSpan.FromMilliseconds(500));
                StateHasChanged();
            }
        });

        try
        {
            var begin = AppState.Settings.Begin;
            var end = AppState.Settings.End;
            var requests = AppState.Settings.SelectedCatalogItems
                .ToList()
                .SelectMany(catalogItem => catalogItem.Kinds.Select(kind =>
                (
                    CatalogItem: catalogItem,
                    Kind: kind,
                    ResourcePath: catalogItem.GetResourcePath(kind, AppState.Settings.SamplePeriod.Value)
                )))
                .ToList();
            var lineSeriesSet = new List<LineSeries>();

            if (requests.Count > 0)
            {
                var resourcePaths = requests.Select(request => request.ResourcePath).ToArray();
                var data = await Client.LoadAsync(
                    begin,
                    end,
                    resourcePaths,
                    progress => _progress = progress,
                    _cts!.Token);

                foreach (var request in requests)
                {
                    var dataResponse = data[request.ResourcePath];
                    var kindAsString = Utilities.KindToString(request.Kind);
                    var name = kindAsString is null
                        ? dataResponse.Name!
                        : $"{dataResponse.Name} ({kindAsString})";

                    lineSeriesSet.Add(new LineSeries(
                        name,
                        dataResponse.Unit ?? string.Empty,
                        AppState.Settings.SamplePeriod.Value,
                        dataResponse.Values));
                }
            }

            _lineSeriesData = new LineSeriesData(begin, end, lineSeriesSet);   
        }
        catch (OperationCanceledException)
        {
        //
        }
        catch (Exception ex)
        {
            AppState.AddError(ex, Snackbar);
        }
        finally
        {
            _isLoading = false;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        _cts?.Cancel();

        AppState.PropertyChanged -= _handler;
        AppState.Settings.PropertyChanged -= _handler;
    }
}
