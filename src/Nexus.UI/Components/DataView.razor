@implements IDisposable
@using System.Buffers

@inject ISnackbar Snackbar
@inject AppState AppState
@inject INexusClient Client
@inject IJSInProcessRuntime JSRuntime

@if (_sizeLimitExceeded)
{
    <div class="h-2/3 flex flex-col justify-center items-center mx-auto text-gray-300">
        <span class="font-bold text-2xl">¯\_(ツ)_/¯</span>
        <span class="mt-5 text-3xl ">Size limit (@(AppState.UISettings.EffectiveDataViewMemoryLimitMiB) MiB) exceeded</span>
        <span class="mt-3 text-lg text-gray-400">Increase the data view memory limit in the settings.</span>
    </div>
}
else
{
    if (_lineSeriesData is null)
    {
        <div class="h-full flex justify-center items-center mx-auto">
            <MudProgressCircular 
            Color="Color.Primary"
            Value="_progress"
            Max="1" />
            <span class="ml-3 text-gray-400">Loading data ...</span>
        </div>
    }

    else
    {
        <div class="h-full p-5 relative">
            <Chart @key="_chartKey" LineSeriesData="_lineSeriesData" BeginAtZero="AppState.BeginAtZero" />

            <MudOverlay Visible="_isLoading" DarkBackground Absolute>
                <div class="h-full flex justify-center items-center mx-auto">
                    <MudProgressCircular
                    Color="Color.Primary"
                    Value="_progress"
                    Max="1" />
                    <span class="ml-3 text-gray-400">Loading data ...</span>
                </div>
            </MudOverlay>

            <MudOverlay Visible="_showReloadButton && !_isLoading" DarkBackground AutoClose Absolute>
                <MudButton
                StartIcon="@Icons.Material.Filled.Refresh"
                Variant="Variant.Filled"
                Color="Color.Secondary"
                OnClick="LoadDataAsync">
                    Reload
                </MudButton>
            </MudOverlay>
        </div>
    }
}

@code {

    private PropertyChangedEventHandler _handler;

    private bool _sizeLimitExceeded;

    private bool _isLoading;

    private double _progress;

    private bool _showReloadButton;

    private LineSeriesData? _lineSeriesData;

    private VisualizationBuffers? _visualizationBuffers;

    private int _chartKey;

    private CancellationTokenSource? _cts;

    private bool IsPerformanceLoggingEnabled()
    {
        try
        {
            return JSRuntime.Invoke<bool>("nexus.chartWebGpu.isPerformanceLoggingEnabled");
        }
        catch (JSException)
        {
            return false;
        }
        catch (InvalidOperationException)
        {
            return false;
        }
    }

    private static void LogPerformance(string message) =>
        Console.WriteLine($"[nexus chart perf] {DateTimeOffset.Now:HH:mm:ss.fff} {message}");

    private static double GetElapsedMilliseconds(long startTimestamp) =>
        (System.Diagnostics.Stopwatch.GetTimestamp() - startTimestamp) * 1000.0 / System.Diagnostics.Stopwatch.Frequency;

    public DataView()
    {
        _handler = (sender, e) =>
        {
            if (e.PropertyName == nameof(AppState.BeginAtZero))
            {
                StateHasChanged();
            }

            else if (e.PropertyName == nameof(AppState.Settings.CanVisualize) ||
                     e.PropertyName == nameof(AppState.Settings.IsSizeLimitExceeded) ||
                     e.PropertyName == nameof(AppState.UISettings))
            {
                var wasExceeded = _sizeLimitExceeded;
                _sizeLimitExceeded = AppState.Settings.IsSizeLimitExceeded;
                _showReloadButton = !_sizeLimitExceeded && AppState.Settings.CanVisualize;

                if (wasExceeded && !_sizeLimitExceeded && _lineSeriesData is null)
                    _ = LoadDataAsync();

                StateHasChanged();
            }
        };
    }

    protected override Task OnInitializedAsync()
    {
        AppState.PropertyChanged += _handler;
        AppState.Settings.PropertyChanged += _handler;

        return LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (_isLoading)
        {
            _cts?.Cancel();
            return;
        }

        var previousCts = _cts;
        previousCts?.Cancel();

        _showReloadButton = false;

        await ReleaseCurrentVisualizationAsync();

        if (AppState.Settings.IsSizeLimitExceeded)
        {
            _sizeLimitExceeded = true;
            _isLoading = false;
            _cts = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var cts = new CancellationTokenSource();
        _cts = cts;

        _sizeLimitExceeded = false;
        _progress = 0;
        _isLoading = true;

        await InvokeAsync(StateHasChanged);

        var logPerf = IsPerformanceLoggingEnabled();
        var totalTimestamp = logPerf ? System.Diagnostics.Stopwatch.GetTimestamp() : 0;
        var batchStreamPerformanceLoggingHadSwitch = false;
        var batchStreamPerformanceLoggingPreviousValue = false;

        if (logPerf)
        {
            batchStreamPerformanceLoggingHadSwitch = AppContext.TryGetSwitch("Nexus.BatchStreamPerformanceLogging", out batchStreamPerformanceLoggingPreviousValue);
            AppContext.SetSwitch("Nexus.BatchStreamPerformanceLogging", true);
        }

        var progressTask = Task.Run(async () =>
        {
            while (!cts.IsCancellationRequested && ReferenceEquals(_cts, cts) && _isLoading)
            {
                await Task.Delay(TimeSpan.FromMilliseconds(500), cts.Token);

                if (ReferenceEquals(_cts, cts))
                    await InvokeAsync(StateHasChanged);
            }
        }, cts.Token);

        VisualizationBuffers? loadBuffers = null;

        try
        {
            var begin = AppState.Settings.Begin;
            var end = AppState.Settings.End;
            var requests = AppState.Settings.SelectedCatalogItems
                .ToList()
                .SelectMany(catalogItem => catalogItem.Kinds.Select(kind =>
                (
                    CatalogItem: catalogItem,
                    Kind: kind,
                    ResourcePath: catalogItem.GetResourcePath(kind, AppState.Settings.SamplePeriod.Value)
                )))
                .ToList();
            if (requests.Count > Constants.MAXIMUM_BATCH_STREAM_RESOURCE_COUNT)
                throw new InvalidOperationException($"A maximum of {Constants.MAXIMUM_BATCH_STREAM_RESOURCE_COUNT} resources can be loaded at once.");

            if (requests.Count > 0)
            {
                void AssignLineSeriesDataIfReady()
                {
                    if (!ReferenceEquals(_cts, cts) ||
                        loadBuffers is null ||
                        _lineSeriesData is not null ||
                        !loadBuffers.AreSourcesReady)
                    {
                        return;
                    }

                    var lineSeriesSet = requests.Select(request =>
                    {
                        var kindAsString = Utilities.KindToString(request.Kind);
                        var name = kindAsString is null
                            ? request.CatalogItem.BaseItem.Resource.Id
                            : $"{request.CatalogItem.BaseItem.Resource.Id} ({kindAsString})";

                        return new LineSeries(
                            name,
                            request.CatalogItem.BaseItem.Unit ?? string.Empty,
                            AppState.Settings.SamplePeriod.Value,
                            loadBuffers.GetSource(request.ResourcePath)!);
                    }).ToList();

                    _chartKey++;
                    _lineSeriesData = new LineSeriesData(begin, end, lineSeriesSet);
                    _visualizationBuffers = loadBuffers;
                    if (logPerf)
                        LogPerformance($"stream assign chartKey={_chartKey} series={lineSeriesSet.Count} elapsedMs={GetElapsedMilliseconds(totalTimestamp):F1}");
                    _ = InvokeAsync(StateHasChanged);
                }

                var resourcePaths = requests.Select(request => request.ResourcePath).ToArray();
                loadBuffers = new VisualizationBuffers(resourcePaths, AssignLineSeriesDataIfReady, logPerf);
                var loadTimestamp = logPerf ? System.Diagnostics.Stopwatch.GetTimestamp() : 0;
                if (logPerf)
                    LogPerformance($"stream loadStart resources={resourcePaths.Length} begin={begin:O} end={end:O}");
                _ = await Client.LoadAsync<float>(
                    begin,
                    end,
                    resourcePaths,
                    loadBuffers.ProvideBuffer,
                    progress =>
                    {
                        if (ReferenceEquals(_cts, cts))
                            _progress = progress;
                    },
                    cts.Token);

                if (logPerf)
                    LogPerformance($"stream loadReturned resources={resourcePaths.Length} loadMs={GetElapsedMilliseconds(loadTimestamp):F1} elapsedMs={GetElapsedMilliseconds(totalTimestamp):F1}");
                loadBuffers.Complete();
                if (logPerf)
                    LogPerformance($"stream complete resources={resourcePaths.Length} elapsedMs={GetElapsedMilliseconds(totalTimestamp):F1}");
                AssignLineSeriesDataIfReady();

                if (ReferenceEquals(_cts, cts) && ReferenceEquals(_visualizationBuffers, loadBuffers))
                    loadBuffers = null;
            }
            else if (ReferenceEquals(_cts, cts))
            {
                _chartKey++;
                _lineSeriesData = new LineSeriesData(begin, end, []);
                if (logPerf)
                    LogPerformance($"stream assignEmpty chartKey={_chartKey} elapsedMs={GetElapsedMilliseconds(totalTimestamp):F1}");
            }
        }
        catch (OperationCanceledException)
        {
            if (logPerf)
                LogPerformance($"stream cancelled elapsedMs={GetElapsedMilliseconds(totalTimestamp):F1}");
        }
        catch (Exception ex)
        {
            if (logPerf)
                LogPerformance($"stream failed type={ex.GetType().Name} message='{ex.Message}' elapsedMs={GetElapsedMilliseconds(totalTimestamp):F1}");

            if (ReferenceEquals(_cts, cts))
                AppState.AddError(ex, Snackbar);
        }
        finally
        {
            if (logPerf)
                AppContext.SetSwitch("Nexus.BatchStreamPerformanceLogging", batchStreamPerformanceLoggingHadSwitch && batchStreamPerformanceLoggingPreviousValue);

            cts.Cancel();

            try
            {
                await progressTask;
            }
            catch (OperationCanceledException) when (cts.IsCancellationRequested)
            {
            }

            if (ReferenceEquals(_cts, cts))
            {
                _isLoading = false;
                _cts = null;
                await InvokeAsync(StateHasChanged);
            }

            cts.Dispose();
            loadBuffers?.Dispose();
        }
    }

    private async Task ReleaseCurrentVisualizationAsync()
    {
        if (_lineSeriesData is null && _visualizationBuffers is null)
            return;

        var logPerf = IsPerformanceLoggingEnabled();
        var releaseTimestamp = logPerf ? System.Diagnostics.Stopwatch.GetTimestamp() : 0;

        if (_lineSeriesData is not null)
        {
            _chartKey++;
            _lineSeriesData = null;

            await InvokeAsync(StateHasChanged);
            await Task.Yield();
        }

        _visualizationBuffers?.Dispose();
        _visualizationBuffers = null;

        GC.Collect();
        GC.WaitForPendingFinalizers();
        GC.Collect();

        if (logPerf)
            LogPerformance($"stream releaseCurrent releaseMs={GetElapsedMilliseconds(releaseTimestamp):F1}");
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _visualizationBuffers?.Dispose();
        _visualizationBuffers = null;

        AppState.PropertyChanged -= _handler;
        AppState.Settings.PropertyChanged -= _handler;
    }

    private sealed class VisualizationBuffers : IDisposable
    {
        private readonly Dictionary<string, ResourceBuffers> _resources = [];
        private readonly List<IMemoryOwner<float>> _owners = [];
        private readonly HashSet<string> _pendingResourcePaths;
        private readonly Action _onSourcesReady;
        private readonly bool _logPerf;

        public VisualizationBuffers(IEnumerable<string> resourcePaths, Action onSourcesReady, bool logPerf)
        {
            _pendingResourcePaths = resourcePaths.ToHashSet();
            _onSourcesReady = onSourcesReady;
            _logPerf = logPerf;
        }

        public bool AreSourcesReady => _pendingResourcePaths.Count == 0;

        public Memory<float> ProvideBuffer(string resourcePath, int chunkLength, long remainingLength)
        {
            var providerTimestamp = _logPerf ? System.Diagnostics.Stopwatch.GetTimestamp() : 0;

            if (chunkLength == 0)
            {
                if (_logPerf)
                    LogPerformance($"stream provideEmpty resource='{resourcePath}' providerMs={GetElapsedMilliseconds(providerTimestamp):F1}");

                return Memory<float>.Empty;
            }

            if (!_resources.TryGetValue(resourcePath, out var resource))
            {
                resource = new ResourceBuffers(new LineSeriesSource(remainingLength));
                _resources.Add(resourcePath, resource);
                if (_logPerf)
                    LogPerformance($"stream sourceInitialized resource='{resourcePath}' totalLength={remainingLength}");

                if (_pendingResourcePaths.Remove(resourcePath) && AreSourcesReady)
                {
                    if (_logPerf)
                        LogPerformance("stream sourcesReady");

                    _onSourcesReady();
                }
            }
            else
            {
                PublishCurrent(resource);
            }

            var owner = MemoryPool<float>.Shared.Rent(chunkLength);
            _owners.Add(owner);
            resource.Current = owner.Memory[..chunkLength];

            if (_logPerf)
                LogPerformance($"stream provide resource='{resourcePath}' offset={resource.NextOffset} length={chunkLength} remainingLength={remainingLength} providerMs={GetElapsedMilliseconds(providerTimestamp):F1}");

            return resource.Current;
        }

        public LineSeriesSource? GetSource(string resourcePath) =>
            _resources.TryGetValue(resourcePath, out var resource) ? resource.Source : null;

        public void Complete()
        {
            var completeTimestamp = _logPerf ? System.Diagnostics.Stopwatch.GetTimestamp() : 0;

            foreach (var resource in _resources.Values)
            {
                PublishCurrent(resource);
                resource.Source.Complete();
            }

            if (_logPerf)
                LogPerformance($"stream buffersComplete resources={_resources.Count} completeMs={GetElapsedMilliseconds(completeTimestamp):F1}");
        }

        public void Dispose()
        {
            var disposeTimestamp = _logPerf ? System.Diagnostics.Stopwatch.GetTimestamp() : 0;
            var ownerCount = _owners.Count;
            var resourceCount = _resources.Count;

            foreach (var owner in _owners)
                owner.Dispose();

            _owners.Clear();
            _resources.Clear();

            if (_logPerf)
                LogPerformance($"stream buffersDisposed owners={ownerCount} resources={resourceCount} disposeMs={GetElapsedMilliseconds(disposeTimestamp):F1}");
        }

        private void PublishCurrent(ResourceBuffers resource)
        {
            if (resource.Current.Length == 0)
                return;

            var publishTimestamp = _logPerf ? System.Diagnostics.Stopwatch.GetTimestamp() : 0;
            resource.Source.AddChunk(resource.Current);
            if (_logPerf)
                LogPerformance($"stream publish offset={resource.NextOffset} length={resource.Current.Length} publishMs={GetElapsedMilliseconds(publishTimestamp):F1}");

            resource.NextOffset += resource.Current.Length;
            resource.Current = Memory<float>.Empty;
        }

        private sealed class ResourceBuffers(LineSeriesSource source)
        {
            public LineSeriesSource Source { get; } = source;
            public Memory<float> Current { get; set; }
            public long NextOffset { get; set; }
        }
    }
}
