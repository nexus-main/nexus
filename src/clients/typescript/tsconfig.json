{
    "compilerOptions": {
        "declaration": true,
        "esModuleInterop": true,
        "lib": [
            "DOM",
            "ES2022"
        ],
        "module": "Node16",
        "moduleResolution": "Node16",
        "outDir": "dist",
        "rootDir": ".",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022"
    },
    "exclude": [
        "dist",
        "node_modules"
    ],
    "include": [
        "*.ts"
    ]
}
