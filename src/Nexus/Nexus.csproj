<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkVersion)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" />
    <PackageReference Include="Apollo3zehn.PackageManagement" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning.ApiExplorer" />

    <!-- Temporary workaround for NJsonSchema: https://github.com/RicoSuter/Namotion.Reflection/pull/162 -->
    <PackageReference Include="Namotion.Reflection" />
    <PackageReference Include="NJsonSchema" />
    <PackageReference Include="NSwag.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.ClientInfo" />
    <PackageReference Include="Serilog.Enrichers.CorrelationId" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Expressions" />
    <PackageReference Include="Serilog.Sinks.Grafana.Loki" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../extensibility/dotnet-extensibility/dotnet-extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Build the Angular UI and copy the production bundle into wwwroot so the
    server can serve it as static files. Runs unconditionally during publish.
  -->
  <Target Name="BuildAngularUI" BeforeTargets="Publish">
    <PropertyGroup>
      <AngularProjectDir>$(MSBuildThisFileDirectory)../Nexus.UI</AngularProjectDir>
      <AngularDistDir>$(AngularProjectDir)/dist/nexus-ui/browser</AngularDistDir>
      <WwwrootDir>$(MSBuildThisFileDirectory)wwwroot</WwwrootDir>
    </PropertyGroup>

    <Message Importance="high" Text="Building Angular UI..." />

    <Exec Command="npm ci" WorkingDirectory="$(AngularProjectDir)" />

    <Exec Command="npm run build" WorkingDirectory="$(AngularProjectDir)" />

    <ItemGroup>
      <AngularDistFiles Include="$(AngularDistDir)/**/*" />
    </ItemGroup>

    <Copy SourceFiles="@(AngularDistFiles)"
          DestinationFiles="@(AngularDistFiles->'$(WwwrootDir)/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!--
    Copy Angular output to the publish output directory. This is needed because
    MSBuild's Content globbing runs at evaluation time, before BuildAngularUI
    creates the files in wwwroot.
  -->
  <Target Name="CopyAngularToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <AngularProjectDir>$(MSBuildThisFileDirectory)../Nexus.UI</AngularProjectDir>
      <AngularDistDir>$(AngularProjectDir)/dist/nexus-ui/browser</AngularDistDir>
      <PublishWwwrootDir>$(PublishDir)wwwroot</PublishWwwrootDir>
    </PropertyGroup>

    <ItemGroup>
      <AngularDistFiles Include="$(AngularDistDir)/**/*" />
    </ItemGroup>

    <Copy SourceFiles="@(AngularDistFiles)"
          DestinationFiles="@(AngularDistFiles->'$(PublishWwwrootDir)/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
