{
    "version": "2.0.0",
    "options": {
        "env": {
            "ASPNETCORE_ENVIRONMENT": "Development"
        }
    },
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Nexus/Nexus.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "--project",
                "${workspaceFolder}/src/Nexus/Nexus.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "npm: dev",
            "type": "npm",
            "script": "dev",
            "path": "src/Nexus.UI",
            "isBackground": true,
            "problemMatcher": {
                "owner": "nexus-ui-dev",
                "source": "typescript",
                "applyTo": "allDocuments",
                "severity": "error",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/src/Nexus.UI"
                ],
                "pattern": {
                    "regexp": "^\\s*(.*?):(\\d+):(\\d+)\\s*-\\s*error\\s+TS\\d+:\\s*(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Application bundle generation complete",
                    "endsPattern": "http://localhost:4200/"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "group": "nexus-ui"
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "npm: build",
            "type": "npm",
            "script": "build",
            "path": "src/Nexus.UI",
            "problemMatcher": {
                "owner": "nexus-ui-build",
                "source": "typescript",
                "applyTo": "allDocuments",
                "severity": "error",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/src/Nexus.UI"
                ],
                "pattern": {
                    "regexp": "^\\s*(.*?):(\\d+):(\\d+)\\s*$",
                    "file": 1,
                    "line": 2,
                    "column": 3
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "build-generator",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Nexus.ClientGenerator/Nexus.ClientGenerator.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}